rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Perfis: todos leem; só o dono cria (junto com a reserva do nome do personagem).
    match /profiles/{uid} {
      allow read: if true;
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.characterName is string
        && request.resource.data.characterName.size() >= 2
        && request.resource.data.characterName.size() <= 40
        && request.resource.data.characterKey is string
        && getAfter(/databases/$(database)/documents/characterClaims/$(request.resource.data.characterKey)).data.uid == uid;
      allow update, delete: if false;
    }

    // Reserva de nome de personagem (impede dois cadastros com o mesmo nome).
    match /characterClaims/{characterKey} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/characterClaims/$(characterKey));
      allow update, delete: if false;
    }

    // Publicações: todos leem; só quem tem perfil publica, com o próprio nome de personagem.
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.characterName
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if owns(resource.data.authorUid);
    }

    // Curtidas: todos leem; cada pessoa cria/remove só a própria (id = postId_uid).
    match /likes/{likeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
      allow update: if false;
      allow delete: if owns(resource.data.uid);
    }

    // Comentários: todos leem; só quem tem perfil comenta, com o próprio nome de personagem, em post existente.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.characterName
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if owns(resource.data.authorUid);
    }
  }
}
