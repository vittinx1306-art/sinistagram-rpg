rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validText(value, max) { return value is string && value.size() <= max; }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'player'
        && request.resource.data.characterKey is string
        && getAfter(/databases/$(database)/documents/characterClaims/$(request.resource.data.characterKey)).data.uid == uid
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.characterKey == resource.data.characterKey
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.role == resource.data.role
        && validText(request.resource.data.characterName, 40)
        && validText(request.resource.data.bio, 160)
        && validText(request.resource.data.avatarUrl, 1000);
      allow delete: if false;

      match /following/{targetUid} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.resource.data.uid == targetUid;
        allow delete: if owns(uid);
        allow update: if false;
      }
    }

    match /handles/{handle} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !exists(/databases/$(database)/documents/handles/$(handle));
      allow update, delete: if false;
    }

    match /characterClaims/{characterKey} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !exists(/databases/$(database)/documents/characterClaims/$(characterKey));
      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.authorHandle == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle
        && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.characterName
        && validText(request.resource.data.text, 500)
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if true;
        allow create: if owns(uid) && request.resource.data.uid == uid;
        allow delete: if owns(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
          && request.resource.data.authorHandle == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle
          && validText(request.resource.data.text, 220)
          && request.resource.data.text.size() > 0;
        allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }
    }

    match /usersPrivate/{uid}/likes/{postId} {
      allow read, create, delete: if owns(uid);
      allow update: if false;
    }
  }
}
